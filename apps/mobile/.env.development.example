# Copy to apps/mobile/.env for local development against a machine-reachable web API.

EXPO_PUBLIC_CREATE_ENV=DEVELOPMENT

# LAN IP of your PC running apps/web (Android emulator: 10.0.2.2 often maps to host)
EXPO_PUBLIC_BASE_URL=http://192.168.1.10:5173
EXPO_PUBLIC_PROXY_BASE_URL=http://192.168.1.10:5173
EXPO_PUBLIC_HOST=192.168.1.10:5173

# Must match your Create project id (see existing .env)
EXPO_PUBLIC_PROJECT_GROUP_ID=

EXPO_PUBLIC_APP_URL=http://192.168.1.10:5173
EXPO_PUBLIC_BASE_CREATE_USER_CONTENT_URL=https://raw.createusercontent.com
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_UPLOADCARE_PUBLIC_KEY=

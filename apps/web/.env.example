# Copy to apps/web/.env and adjust values.



# PostgreSQL (local Docker: postgres://app:app@localhost:5432/surveyapp

# or through PgBouncer: postgres://app:app@localhost:6432/surveyapp)

DATABASE_URL=

# Render: use the internal DATABASE_URL from the web service dashboard for the app
# running on Render (same private network as Postgres). Use the external URL only
# for tools on your machine (e.g. migrations). Optional: DATABASE_SSL=true forces
# TLS on the pool when your host needs SSL but does not match the built-in heuristics.

# Auth.js

AUTH_SECRET=

# Public URL of this web app (http for local, https in production)

AUTH_URL=http://localhost:4000

# Structured logging (optional): LOG_DEBUG=true enables logger.debug() on the server;
# VITE_LOG_DEBUG=true enables it in the client bundle. In local dev, debug logs also
# show when import.meta.env.DEV is true.



# Optional: comma-separated browser origins for CORS

# CORS_ORIGINS=http://localhost:4000



# Pool / query tuning (optional)

# DB_POOL_MAX=20

# DB_POOL_IDLE_TIMEOUT_MS=30000

# DB_POOL_CONNECTION_TIMEOUT_MS=10000

# DB_STATEMENT_TIMEOUT_MS=15000

# DB_TRANSACTION_TIMEOUT_MS=45000



# ---------------------------------------------------------------------------

# Email (pick one transport; first match wins in sendAppEmail)

# ---------------------------------------------------------------------------



# Gmail SMTP (Nodemailer) — enable 2-Step Verification, then create an App Password:

# Google Account → Security → 2-Step Verification → App passwords → Mail.

# Use the 16-character app password (spaces optional).

GMAIL_USER=

GMAIL_APP_PASSWORD=



# From header (should match your Gmail or a "Send mail as" alias in Gmail)

EMAIL_FROM=SurveyTasker <you@gmail.com>



# Optional: generic SMTP instead of Gmail (e.g. your own relay)

# SMTP_HOST=

# SMTP_PORT=587

# SMTP_SECURE=false

# SMTP_USER=

# SMTP_PASS=



# Optional: Resend HTTP API (fallback if SMTP not configured)

# RESEND_API_KEY=

# First admin (run from apps/web: node --env-file=.env scripts/seed-admin.mjs)
# ADMIN_BOOTSTRAP_USERNAME=surveyadmin
# ADMIN_BOOTSTRAP_PASSWORD=change-me-strong-password

# Inbound contact form emails (defaults to GMAIL_USER if set)
# CONTACT_INBOX_EMAIL=

